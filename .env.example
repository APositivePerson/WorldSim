# 智谱开放平台 API Key：https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-5.3
# GLM-5.3 不支持关闭思考，必须使用 enabled 或留空
GLM_THINKING=enabled
# low / high / max；顾客简短对话建议 low；旧模型不支持时留空
GLM_REASONING_EFFORT=low

# 第一轮视觉检查，默认复用 GLM_API_KEY / GLM_BASE_URL
VLM_MODEL=glm-4.6v
VLM_TIMEOUT=60
# 使用独立账户或端点时再填写：
# VLM_API_KEY=
# VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
